{
  "id": "plantops",
  "realm": "plantops",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "sslRequired": "external",
  "clients": [
    {
      "clientId": "plantops-ui",
      "name": "PlantOps UI",
      "enabled": true,
      "publicClient": false,
      "secret": "plantops-ui-secret",
      "redirectUris": [
        "http://localhost:5173/",
        "http://localhost:5173/*",
        "http://localhost:8080/",
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:8080",
        "+"
      ],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:8080/*"
      }
    }
  ],
  "users": [
    {
      "username": "dev",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ],
      "realmRoles": ["default-roles-plantops"]
    },
    {
      "username": "planner",
      "enabled": true,
      "emailVerified": true,
      "firstName": "计划员",
      "lastName": "Planner",
      "credentials": [
        {
          "type": "password",
          "value": "planner",
          "temporary": false
        }
      ],
      "realmRoles": ["default-roles-plantops"]
    }
  ]
}
