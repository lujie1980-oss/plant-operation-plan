# 复制为 acr.local.env 并填写（该文件已被 .gitignore 忽略，勿提交密码）
# 阿里云控制台 → 容器镜像服务 ACR → 实例列表 → 访问凭证

# 镜像仓库地址（示例：华东1 杭州个人版）
ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com

# 命名空间 + 仓库名（在 ACR 控制台创建）
ACR_NAMESPACE=your-namespace
ACR_REPO=plant-operation-plan

# 本地镜像 tag
LOCAL_IMAGE=plant-operation-plan:1.0.0

# 推送到 ACR 的版本 tag
ACR_TAG=1.0.0

# 登录用户名：通常是阿里云账号全名，或 ACR 控制台「固定密码」页显示的用户名
ACR_USERNAME=your-aliyun-account

# 固定密码（在 ACR → 访问凭证 里设置，不是登录密码）
# 也可不设此变量，脚本运行时会提示输入
# ACR_PASSWORD=
