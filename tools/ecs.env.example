# Copy to ecs.local.env and fill in (gitignored; do not commit secrets)
# Step 3: deploy container on Aliyun ECS via SSH

# ECS public IP or hostname
ECS_HOST=47.x.x.x

# SSH user (Alibaba Cloud Linux / Ubuntu: root or ecs-user)
ECS_USER=root

# Path to private key (.pem). Leave empty to use default ssh agent / ~/.ssh/config
ECS_SSH_KEY=

# Optional SSH port (default 22)
ECS_SSH_PORT=22

# Container name on ECS
ECS_CONTAINER_NAME=plantops

# Host port mapped to container 8080
ECS_HOST_PORT=8080

# Data directory on ECS (bind mount)
ECS_DATA_DIR=/data/plantops

# Reuse ACR settings from acr.local.env (or override here)
# ACR_REGISTRY=crpi-hjfrj3sdmymxy3ub.cn-hangzhou.personal.cr.aliyuncs.com
# ACR_NAMESPACE=plantops
# ACR_REPO=plant-operation-plan
# ACR_TAG=1.0.0
# ACR_USERNAME=nick2756465108
# ACR_PASSWORD=

# Load demo seed data on first start (true/false)
PLANTOPS_SAMPLE_DATA_ENABLED=false
